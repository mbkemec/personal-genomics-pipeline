configfile: "config/config.yaml"


rule all:
    input:
        "results/processed/autosomal.pgen",
        "results/processed/autosomal.pvar",
        "results/processed/autosomal.psam",
        "results/qc/alleles_compatibility_HO.json",
        "results/qc/alleles_1240K.json",
	"results/harmonized/compatibility_HO_sample_codes.txt",
	"results/harmonized/1240K_sample_codes.txt",
	"results/qc/harmonization_compatibility_HO.json",
	"results/qc/harmonization_1240K.json",
        "results/reference/modern_samples.txt",
        "results/reference/modern_selection.json",
	"results/reference/modern_filter.ind"


rule preprocess:
    input:
        "data/autosomal.csv"
    output:
        tped="results/processed/autosomal.tped",
        tfam="results/processed/autosomal.tfam",
        qc="results/processed/autosomal_qc.json"
    params:
        sample_id=config["sample_id"],
        sex=config["sex"]
    shell:
        """
        python scripts/preprocess_autosomal.py \
            {input} results/processed {params.sample_id} {params.sex}
        """


rule convert_plink:
    input:
        tped="results/processed/autosomal.tped",
        tfam="results/processed/autosomal.tfam"
    output:
        pgen="results/processed/autosomal.pgen",
        pvar="results/processed/autosomal.pvar",
        psam="results/processed/autosomal.psam"
    shell:
        """
        plink2 \
            --tfile results/processed/autosomal \
            --make-pgen \
            --out results/processed/autosomal
        """


rule check_alleles:
    input:
        tped="results/processed/autosomal.tped",
        snp="reference/aadr/v66.p1_{panel}.aadr.patch.PUB.snp"
    output:
        "results/qc/alleles_{panel}.json"
    shell:
        """
        python scripts/check_alleles.py \
            {input.tped} {input.snp} {output}
        """


rule harmonize:
    input:
        tped="results/processed/autosomal.tped",
        snp="reference/aadr/v66.p1_{panel}.aadr.patch.PUB.snp"
    output:
        codes="results/harmonized/{panel}_sample_codes.txt",
        qc="results/qc/harmonization_{panel}.json"
    shell:
        """
        python scripts/harmonize_genotypes.py \
            {input.tped} {input.snp} {output.codes} {output.qc}
        """

rule select_modern_samples:
    input:
        config="config/reference_populations.yaml",
        ind="reference/aadr/v66.p1_compatibility_HO.aadr.patch.PUB.ind",
        anno="reference/aadr/v66.p1_compatibility_HO.aadr.PUB.anno"
    output:
        ids="results/reference/modern_samples.txt",
        report="results/reference/modern_selection.json"
    shell:
        """
        python scripts/select_modern_samples.py \
            --config {input.config} \
            --ind {input.ind} \
            --anno {input.anno} \
            --output-ids {output.ids} \
            --output-report {output.report}
        """

rule prepare_reference_ind:
    input:
        ind="reference/aadr/v66.p1_compatibility_HO.aadr.patch.PUB.ind",
        selected="results/reference/modern_samples.txt"
    output:
        "results/reference/modern_filter.ind"
    shell:
        """
        python scripts/prepare_reference_ind.py \
            --ind {input.ind} \
            --selected {input.selected} \
            --output {output}
        """
