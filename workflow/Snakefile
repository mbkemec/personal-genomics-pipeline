configfile: "config/config.yaml"


rule all:
    input:
        "results/processed/autosomal.pgen",
        "results/processed/autosomal.pvar",
        "results/processed/autosomal.psam",
        "results/qc/alleles_compatibility_HO.json",
        "results/qc/alleles_1240K.json",
	"results/harmonized/compatibility_HO_sample_codes.txt",
	"results/harmonized/1240K_sample_codes.txt",
	"results/harmonized/compatibility_HO_matched_snps.txt",
	"results/harmonized/1240K_matched_snps.txt",
	"results/qc/harmonization_compatibility_HO.json",
	"results/qc/harmonization_1240K.json",
        "results/reference/modern_samples.txt",
        "results/reference/modern_selection.json",
	"results/reference/modern_filter.ind",
	"results/reference/modern.geno",
	"results/reference/modern.snp",
	"results/reference/modern.ind",
	"reports/modern_reference_qc.json",
	"results/reference/modern_plink.bed",
	"results/reference/modern_plink.bim",
	"results/reference/modern_plink.fam",
	"results/reference/modern_missingness.vmiss",	
	"reports/reference_missingness_qc.json",
	"results/reference/modern_qc.bed",
	"results/reference/modern_qc.bim",
	"results/reference/modern_qc.fam",
	"results/reference/modern_ld.prune.in",
	"results/reference/modern_ld.prune.out",
	"results/reference/shared_snps.txt",
	"reports/shared_snps_qc.json",
	"results/reference/shared.bed",
	"results/reference/shared.bim",
	"results/reference/shared.fam",
	"results/reference/shared_ld.prune.in",
	"results/reference/shared_ld.prune.out",
	"results/reference/pca_reference.bed",
	"results/reference/pca_reference.bim",
	"results/reference/pca_reference.fam",
	"results/pca/sample.geno",
	"results/pca/sample.snp",
	"results/pca/sample.ind",	
	"results/pca/merged.geno",
	"results/pca/merged.snp",
	"results/pca/merged.ind",
	"results/pca/pca.evec",
	"results/pca/pca.eval",

rule preprocess:
    input:
        "data/autosomal.csv"
    output:
        tped="results/processed/autosomal.tped",
        tfam="results/processed/autosomal.tfam",
        qc="results/processed/autosomal_qc.json"
    params:
        sample_id=config["sample_id"],
        sex=config["sex"]
    shell:
        """
        python scripts/preprocess_autosomal.py \
            {input} results/processed {params.sample_id} {params.sex}
        """


rule convert_plink:
    input:
        tped="results/processed/autosomal.tped",
        tfam="results/processed/autosomal.tfam"
    output:
        pgen="results/processed/autosomal.pgen",
        pvar="results/processed/autosomal.pvar",
        psam="results/processed/autosomal.psam"
    shell:
        """
        plink2 \
            --tfile results/processed/autosomal \
            --make-pgen \
            --out results/processed/autosomal
        """


rule check_alleles:
    input:
        tped="results/processed/autosomal.tped",
        snp="reference/aadr/v66.p1_{panel}.aadr.patch.PUB.snp"
    output:
        "results/qc/alleles_{panel}.json"
    shell:
        """
        python scripts/check_alleles.py \
            {input.tped} {input.snp} {output}
        """


rule harmonize:
    input:
        tped="results/processed/autosomal.tped",
        snp="reference/aadr/v66.p1_{panel}.aadr.patch.PUB.snp"
    output:
        codes="results/harmonized/{panel}_sample_codes.txt",
        qc="results/qc/harmonization_{panel}.json",
	matched="results/harmonized/{panel}_matched_snps.txt"
    shell:
        """
        python scripts/harmonize_genotypes.py \
            {input.tped} {input.snp} {output.codes} {output.qc} {output.matched}
        """

rule select_modern_samples:
    input:
        config="config/reference_populations.yaml",
        ind="reference/aadr/v66.p1_compatibility_HO.aadr.patch.PUB.ind",
        anno="reference/aadr/v66.p1_compatibility_HO.aadr.PUB.anno"
    output:
        ids="results/reference/modern_samples.txt",
        report="results/reference/modern_selection.json"
    shell:
        """
        python scripts/select_modern_samples.py \
            --config {input.config} \
            --ind {input.ind} \
            --anno {input.anno} \
            --output-ids {output.ids} \
            --output-report {output.report}
        """

rule prepare_reference_ind:
    input:
        ind="reference/aadr/v66.p1_compatibility_HO.aadr.patch.PUB.ind",
        selected="results/reference/modern_samples.txt"
    output:
        "results/reference/modern_filter.ind"
    shell:
        """
        python scripts/prepare_reference_ind.py \
            --ind {input.ind} \
            --selected {input.selected} \
            --output {output}
        """

rule extract_modern_reference:
    input:
        geno="reference/aadr/v66.p1_compatibility_HO.aadr.patch.PUB.geno",
        snp="reference/aadr/v66.p1_compatibility_HO.aadr.patch.PUB.snp",
        ind="results/reference/modern_filter.ind",
	par="config/convertf_modern.par"
    output:
        geno="results/reference/modern.geno",
        snp="results/reference/modern.snp",
        ind="results/reference/modern.ind"
    log:
        "logs/convertf_modern.log"
    shell:
        """
        mkdir -p logs
        convertf -p {input.par} > {log} 2>&1
        """

rule validate_modern_reference:
    input:
        original_ind="reference/aadr/v66.p1_compatibility_HO.aadr.patch.PUB.ind",
        original_snp="reference/aadr/v66.p1_compatibility_HO.aadr.patch.PUB.snp",
        selected="results/reference/modern_samples.txt",
        extracted_ind="results/reference/modern.ind",
        extracted_snp="results/reference/modern.snp",
        extracted_geno="results/reference/modern.geno"
    output:
        "reports/modern_reference_qc.json"
    shell:
        """
        python scripts/validate_modern_reference.py \
            --original-ind {input.original_ind} \
            --selected {input.selected} \
            --extracted-ind {input.extracted_ind} \
            --original-snp {input.original_snp} \
            --extracted-snp {input.extracted_snp} \
            --extracted-geno {input.extracted_geno} \
            --output {output}
        """

rule convert_reference_plink:
    input:
        geno="results/reference/modern.geno",
        snp="results/reference/modern.snp",
        ind="results/reference/modern.ind",
        par="config/convertf_plink.par"
    output:
        bed="results/reference/modern_plink.bed",
        bim="results/reference/modern_plink.bim",
        fam="results/reference/modern_plink.fam"
    log:
        "logs/convertf_plink.log"
    shell:
        """
        mkdir -p logs
        convertf -p {input.par} > {log} 2>&1
        """

rule reference_missingness:
    input:
        bed="results/reference/modern_plink.bed",
        bim="results/reference/modern_plink.bim",
        fam="results/reference/modern_plink.fam"
    output:
        vmiss="results/reference/modern_missingness.vmiss"
    log:
        "logs/reference_missingness.log"
    shell:
        """
        plink2 \
          --bfile results/reference/modern_plink \
          --missing variant-only \
          --out results/reference/modern_missingness \
          > {log} 2>&1
        """

rule summarize_reference_missingness:
    input:
        vmiss="results/reference/modern_missingness.vmiss"
    output:
        "reports/reference_missingness_qc.json"
    shell:
        """
        python scripts/summarize_reference_missingness.py \
            --vmiss {input.vmiss} \
            --output {output}
        """

rule filter_reference_missingness:
    input:
        bed="results/reference/modern_plink.bed",
        bim="results/reference/modern_plink.bim",
        fam="results/reference/modern_plink.fam",
        qc="reports/reference_missingness_qc.json"
    output:
        bed="results/reference/modern_qc.bed",
        bim="results/reference/modern_qc.bim",
        fam="results/reference/modern_qc.fam"
    log:
        "logs/reference_filter_missingness.log"
    shell:
        """
        plink2 \
            --bfile results/reference/modern_plink \
            --geno 0.05 \
            --make-bed \
            --out results/reference/modern_qc \
            > {log} 2>&1
        """

rule prune_reference_ld:
    input:
        bed="results/reference/modern_qc.bed",
        bim="results/reference/modern_qc.bim",
        fam="results/reference/modern_qc.fam"
    output:
        prune_in="results/reference/modern_ld.prune.in",
        prune_out="results/reference/modern_ld.prune.out"
    log:
        "logs/reference_ld_pruning.log"
    shell:
        """
        plink2 \
            --bfile results/reference/modern_qc \
            --indep-pairwise 200 50 0.2 \
            --out results/reference/modern_ld \
            > {log} 2>&1
        """

rule select_shared_snps:
    input:
        matched="results/harmonized/compatibility_HO_matched_snps.txt",
        bim="results/reference/modern_qc.bim"
    output:
        snps="results/reference/shared_snps.txt",
        report="reports/shared_snps_qc.json"
    shell:
        """
        python scripts/select_shared_snps.py \
            --matched {input.matched} \
            --bim {input.bim} \
            --output {output.snps} \
            --report {output.report}
        """

rule extract_shared_reference:
    input:
        bed="results/reference/modern_qc.bed",
        bim="results/reference/modern_qc.bim",
        fam="results/reference/modern_qc.fam",
        snps="results/reference/shared_snps.txt"
    output:
        bed="results/reference/shared.bed",
        bim="results/reference/shared.bim",
        fam="results/reference/shared.fam"
    log:
        "logs/extract_shared_reference.log"
    shell:
        """
        plink2 \
            --bfile results/reference/modern_qc \
            --extract {input.snps} \
            --make-bed \
            --out results/reference/shared \
            > {log} 2>&1
        """

rule prune_shared_ld:
    input:
        bed="results/reference/shared.bed",
        bim="results/reference/shared.bim",
        fam="results/reference/shared.fam"
    output:
        prune_in="results/reference/shared_ld.prune.in",
        prune_out="results/reference/shared_ld.prune.out"
    log:
        "logs/shared_ld_pruning.log"
    threads: 8
    shell:
        """
        plink2 \
            --bfile results/reference/shared \
            --indep-pairwise 200 50 0.2 \
            --threads {threads} \
            --out results/reference/shared_ld \
            > {log} 2>&1
        """
rule extract_pca_reference:
    input:
        bed="results/reference/shared.bed",
        bim="results/reference/shared.bim",
        fam="results/reference/shared.fam",
        snps="results/reference/shared_ld.prune.in"
    output:
        bed="results/reference/pca_reference.bed",
        bim="results/reference/pca_reference.bim",
        fam="results/reference/pca_reference.fam"
    log:
        "logs/extract_pca_reference.log"
    shell:
        """
        plink2 \
            --bfile results/reference/shared \
            --extract {input.snps} \
            --make-bed \
            --out results/reference/pca_reference \
            > {log} 2>&1
        """

rule prepare_sample_eigenstrat:
    input:
        snp="results/reference/modern.snp",
        codes="results/harmonized/compatibility_HO_sample_codes.txt",
        selected="results/reference/shared_ld.prune.in"
    output:
        geno="results/pca/sample.geno",
        snp="results/pca/sample.snp",
        ind="results/pca/sample.ind"
    params:
        sample_id=config["sample_id"],
        sex="M" if config["sex"] == 1 else "F"
    shell:
        """
        python scripts/prepare_sample_eigenstrat.py \
            --snp {input.snp} \
            --codes {input.codes} \
            --selected {input.selected} \
            --sample-id {params.sample_id} \
            --sex {params.sex} \
            --output-prefix results/pca/sample
        """

rule merge_pca_dataset:
    input:
        ref_geno="results/reference/modern.geno",
        ref_snp="results/reference/modern.snp",
        ref_ind="results/reference/modern.ind",
        sample_geno="results/pca/sample.geno",
        sample_snp="results/pca/sample.snp",
        sample_ind="results/pca/sample.ind",
        par="config/mergeit_pca.par"
    output:
        geno="results/pca/merged.geno",
        snp="results/pca/merged.snp",
        ind="results/pca/merged.ind"
    log:
        "logs/mergeit_pca.log"
    shell:
        """
        mergeit -p {input.par} > {log} 2>&1
        """

rule pca_reference_populations:
    input:
        "results/reference/modern.ind"
    output:
        "results/pca/reference_populations.txt"
    shell:
        r"""
        awk '{{print $3}}' {input} | sort -u > {output}
        """

rule run_smartpca:
    input:
        geno="results/pca/merged.geno",
        snp="results/pca/merged.snp",
        ind="results/pca/merged.ind",
        pops="results/pca/reference_populations.txt",
        par="config/smartpca.par"
    output:
        evec="results/pca/pca.evec",
        eval="results/pca/pca.eval"
    log:
        "logs/smartpca.log"
    threads: 8
    shell:
        """
        smartpca -p {input.par} > {log} 2>&1
        """
